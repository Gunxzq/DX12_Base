      "priority": 10,
      "enabled_actions": ["Move", "Look", "MoveUp", "MoveDown", "Sprint", "Select", "OrbitCamera", "FocusSelection", "Delete", "Duplicate", "Undo", "Redo", "Save", "Open", "SaveAs"]
    },
    "Viewport": {
      "priority": 15,
      "enabled_actions": ["Move", "Look", "MoveUp", "MoveDown", "Sprint", "Select", "OrbitCamera", "Zoom", "Pan", "FocusSelection", "ToolCursor", "ToolTranslate", "ToolRotate"]
    },
    "UI": {
      "priority": 20,
      "enabled_actions": ["Select", "Delete", "Undo", "Redo", "Save", "Open", "SaveAs"]
    },
    "Outliner": {
      "priority": 25,
      "enabled_actions": ["Select", "FocusSelection", "Delete", "Duplicate", "Undo", "Redo"]
    }
