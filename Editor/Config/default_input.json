      "enabled_actions": ["Move", "Look", "MoveUp", "MoveDown", "Sprint", "Select", "OrbitCamera", "Zoom", "Pan", "FocusSelection"]
    },
    "UI": {
      "priority": 20,
      "enabled_actions": ["Select", "Delete", "Undo", "Redo", "Save", "Open", "SaveAs"]
    },
    "Outliner": {
      "priority": 25,
      "enabled_actions": ["Select", "FocusSelection", "Delete", "Duplicate", "Undo", "Redo"]
