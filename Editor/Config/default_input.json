      { "key": "Space", "modifier": "Mouse_Right" }
    ],
    "MoveDown": [
      { "key": "LeftControl", "modifier": "Mouse_Right" }
    ],
    "Sprint": [
      { "key": "LeftShift", "requires": "Mouse_Right" }
    ],
    "Select": [
      { "key": "Mouse_Left" }
    ],
    "OrbitCamera": [
      { "key": "Mouse_Right" }
    ],
    "Zoom": [
      { "device": "Mouse", "axis": "Wheel" }
    ],
    "Pan": [
      { "key": "Mouse_Left" },
      { "key": "Mouse_Middle" }
    ],
    "FocusSelection": [
      { "key": "F" }
    ],
