{
  "version": "1.0",
  "bindings": {
    "Move": [
      { "keys": ["W", "A", "S", "D"], "axis_map": {"W": "Y+", "S": "Y-", "A": "X-", "D": "X+"} },
      { "keys": ["Up", "Left", "Down", "Right"], "axis_map": {"Up": "Y+", "Down": "Y-", "Left": "X-", "Right": "X+"} }
    ],
    "Look": [
      { "device": "Mouse", "axis": "Delta" }
    ],
    "MoveUp": [
