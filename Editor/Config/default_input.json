      { "key": "W" }
    ],
    "ToolRotate": [
      { "key": "E" }
    ],
    "Save": [
      { "key": "S", "modifiers": ["LeftControl"] }
    ],
    "Open": [
      { "key": "O", "modifiers": ["LeftControl"] }
    ],
    "SaveAs": [
      { "key": "S", "modifiers": ["LeftControl", "LeftShift"] }
