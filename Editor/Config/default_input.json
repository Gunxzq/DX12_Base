      { "key": "D", "modifiers": ["LeftControl"] }
    ],
    "Undo": [
      { "key": "Z", "modifiers": ["LeftControl"] }
    ],
    "Redo": [
      { "key": "Y", "modifiers": ["LeftControl"] }
