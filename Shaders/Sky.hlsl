//=============================================================================
// Sky.hlsl - 天空盒着色器
// 基于 Frank Luna 的实现，适配当前 PBR 渲染管线
//=============================================================================

#include "Common_PBR.hlsl"

// =================================================================================================
// 顶点输入/输出
// =================================================================================================

struct VertexIn
{
	float3 PosL : POSITION;
	float3 NormalL : NORMAL;
	float2 TexC : TEXCOORD;
};

struct VertexOut
{
	float4 PosH : SV_POSITION;
	float3 PosL : POSITION; // 局部位置作为立方体贴图采样方向
};

// =================================================================================================
// 顶点着色器
// =================================================================================================

VertexOut VS(VertexIn vin)
{
	VertexOut vout;

	// 使用局部顶点位置作为立方体贴图采样方向
	vout.PosL = vin.PosL;

	// 变换到世界空间
	float4 posW = mul(float4(vin.PosL, 1.0f), gWorld);

	// 始终让天空盒围绕相机 (天空盒随相机移动)
	posW.xyz += gCameraPos;

	// 关键技巧: 设置 z = w，使得 z/w = 1
	// 这样天空盒始终位于远平面，不会被其他物体遮挡
	vout.PosH = mul(posW, gViewProj).xyww;

	return vout;
}

// =================================================================================================
// 像素着色器
// =================================================================================================

float4 PS(VertexOut pin) : SV_Target
{
	// 使用局部位置作为方向向量采样立方体贴图
	// 注意: 使用各向异性或线性采样，避免马赫带
	return gEnvMap.Sample(gSamplerAnisotropicWrap, pin.PosL);
}