{
  "logging": {
    "GlobalLevel": "Debug",
    "FlushLevel": "Error",
    "FormatPattern": "[%Y-%m-%d %H:%M:%S.%e] [%l] [thread %t] %v",

    "Sinks": {
      "Console": {
        "Enabled": false,
        "Level": "Info",
        "Colorize": true
      },
      "DebugOutput": {
        "Enabled": false,
        "Level": "Debug"
      },
      "File": {
        "Enabled": true,
        "Level": "Debug",
        "Path": "logs/engine.log",
        "Rotation": {
          "Policy": "size",
          "MaxSizeMb": 10,
          "MaxFiles": 5
        }
      },
      "Async": {
        "Enabled": true,
        "QueueSize": 8192,
        "OverflowPolicy": "discard"
      }
    }
  }
}
