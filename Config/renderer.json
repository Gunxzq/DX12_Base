{
  "renderer": {
    "device": {
      "minFeatureLevel": 11.0,
      "enableDebugLayer": true,
      "enableGPUBasedValidation": false,
      "warpFallback": true
    },
    "swapChain": {
      "bufferCount": 2,
      "refreshRateNumerator": 60,
      "refreshRateDenominator": 1,
      "swapEffect": "FLIP_DISCARD",
      "flags": [
        "ALLOW_MODE_SWITCH"
      ],
      "windowed": true
    },
    "msaa": {
      "enabled": false,
      "sampleCount": 4,
      "qualityLevelAutoDetect": true
    },
    "formats": {
      "backBufferFormat": "R8G8B8A8_UNORM",
      "depthStencilFormat": "D32_FLOAT"
    },
    "viewport": {
      "minDepth": 0.0,
      "maxDepth": 1.0
    }
  }
}